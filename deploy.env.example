# Copy to deploy.env (gitignored) and adjust.
DEPLOY_HOST=docker-host          # ssh host or alias
DEPLOY_DIR=/srv/market-mcp       # project directory on the host
DEPLOY_DOCKER=docker             # e.g. "sudo docker" if your user is not in the docker group
# Alerts (alerts.py) read these from the host .env, not from here: ALERT_NTFY_URL, ALERT_NTFY_TOKEN, ALERT_HA_WEBHOOK
